# ─────────────────────────────────────────────────────────────────────────────
# Environment for the n8n + NemoClaw/OpenShell sandbox + access gateway.
#
# Copy this file to `.env`. `.env` is gitignored; never commit it.
# Inference is filled in for the local Hypernova server. OWNER_PASSWORD is not.
# ─────────────────────────────────────────────────────────────────────────────

# --- Self-hosted n8n version -------------------------------------------------
# Pinned explicitly (n8n/scripts/up.sh) rather than using the untagged
# "n8nio/n8n" tag, which silently reuses whatever ":latest" happens to be
# cached locally and can land on a version that predates the 2.22+
# publish/draft workflow model this repo's scripts assume. Bump as new
# stables ship: https://hub.docker.com/r/n8nio/n8n/tags
N8N_VERSION=2.35.5

# Container and volume names. Deliberately NOT the generic "n8n"/"n8n_data":
# many hosts already run a container by that name, and this demo must never
# collide with or inherit state from one.
N8N_CONTAINER=n8n-gtc
N8N_VOLUME=n8n_gtc_data
N8N_PORT=5678

# The n8n owner account, created by n8n/scripts/setup.sh. Set here rather than
# left to setup.sh's defaults because this identity appears on screen in the
# editor and in any recording, and a rebuild has to reproduce it. An
# administrator, and deliberately NOT the scenario's protagonist: if she
# administered the gateway that governs her, she could switch the policy off
# and the demo would undercut itself.
OWNER_EMAIL=platform@kerbline.example
OWNER_FIRST=Kerbline
OWNER_LAST=Platform
OWNER_PASSWORD=

# --- n8n management MCP endpoint (build-time only) --------------------------
# n8n's own admin surface: it can read, write and run any workflow, so it is how
# the gateway workflows get built (`make rebuild`, via n8n/workflows/build.js),
# and nothing else. The running demo does not use it; n8n/workflows/isolate.sh
# switches it off as the last step of every build. It shares port 5678 with the
# gateway front door; the sandbox policy scopes its grant to the front-door path
# and refuses this one, but that policy covers a single sandbox while the toggle
# closes the surface to everything on the host. `make n8n-mcp-on` turns it back
# on for the next build.
#
# Interpolates N8N_PORT above, so the port is set in one place. Every reader
# expands ${VAR}: the shell scripts source this file, and build.js does it in
# its own parser rather than take a dotenv dependency.
N8N_INSTANCE_URL=http://localhost:${N8N_PORT}/mcp-server/http
# The MCP Server API key (NOT a normal n8n API key; see n8n/scripts/setup.sh
# for why). Minted automatically by n8n/scripts/setup.sh and written back
# into this file's N8N_MCP_TOKEN= line.
N8N_MCP_TOKEN=

# --- Inference (OpenShell gateway provider + `nemoclaw onboard`) -----------
# Local vLLM on this host. The served name is hypernova
# (MultiverseComputingCAI/Hypernova-60B-2605). This server does not check the
# key; it still has to be non-empty, because install.sh and the eval harness
# refuse a blank one.
#
# The URL below is for processes on the host. Two other callers rewrite
# loopback, because neither of them runs on the host:
#   n8n/scripts/create_credential.sh -> host.docker.internal
#   install.sh, for the OpenShell provider -> host.openshell.internal
# Docker Engine on Linux still cannot reach a port published only on
# 127.0.0.1. Run n8n/scripts/bridge_loopback.sh while both are up. It listens
# on the docker bridge and forwards to this loopback port.
# install.sh also writes provider and model into ~/.nemoclaw/sandboxes.json.
# nemoclaw connect restores that record over the live route on every connect.
INFERENCE_API_KEY=local
INFERENCE_BASE_URL=http://127.0.0.1:8000/v1
# The RUNTIME model the sandbox agent reasons with. Applied with --no-verify
# (install.sh) because the OpenShell gateway's inference-set probe can time
# out on large/slow models even when the key and endpoint are fine.
INFERENCE_MODEL=hypernova
# The OpenShell provider type stays nvidia: that type is a base URL plus a key,
# and it is how a self-hosted OpenAI-compatible server is attached. install.sh
# uses the custom onboard path whenever the URL is not integrate.api.nvidia.com.
INFERENCE_PROVIDER_TYPE=nvidia
INFERENCE_PROVIDER_NAME=nvidia

# The ONBOARD-TIME validation model. This host serves one model, so it is the
# same id as INFERENCE_MODEL. A one-sentence completion against it returned in
# under 2 seconds on 2026-10-08, inside onboard's ~15s budget. A longer probe
# with no max_tokens cap can still think past that budget.
NEMOCLAW_ONBOARD_MODEL=hypernova

# --- OpenClaw chat model (optional) -----------------------------------------
# Model used by OpenClaw for the interactive chat UI / TUI, independent of
# the sandbox agent's reasoning model above. Leave blank to use whatever
# OpenClaw defaults to.
OPENCLAW_MODEL=hypernova

# --- Sandbox identity -------------------------------------------------------
# Sandbox name and agent runtime, passed to `nemoclaw onboard --name/--agent`.
# Left unset, onboard picks its own, giving an unpredictable sandbox name in
# every command and doc. The default below is the demo persona's own agent
# (docs/SCENARIO.md); it reads correctly on screen when listing sandboxes.
NEMOCLAW_SANDBOX_NAME=lena-agent
NEMOCLAW_AGENT=openclaw
