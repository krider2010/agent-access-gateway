# Secrets — never commit
.env
.env.*
!.env.template
*.SECRET.*
*.secret
.creds-raw.json
encryption-key.txt
credentials-export.json
*.pem
*.key

# Generated data — the generator is committed, the data is not
seed/out/
seed/data/
# Listed again explicitly, even though seed/out/ already covers it, because the
# size is worth knowing before you wonder where 60 MB went: `seed/generate.py
# --full` writes the datasets at the volumes docs/SCENARIO.md states, which is
# what makes the gateway's aggregates real aggregates rather than statistics
# over a few hundred display rows. Regenerate it, never commit it.
seed/out/full/

# Eval runs (keep goldens, drop run artifacts)
eval/results/*
!eval/results/.gitkeep

# Python
# `.venv-eval/` is the one virtualenv the repo's own tooling builds, and it is
# named explicitly rather than left to the `.gitignore` that `python -m venv`
# writes inside it: that file makes the directory invisible to git today, but it
# is generated, so deleting it or building the venv another way would put a few
# thousand platform-specific files in front of `git add`. It is rebuilt from
# eval/requirements.txt — see docs/EVALS.md §2. Setup itself needs no venv.
# The bare patterns below catch whatever a reader makes by hand.
.venv/
.venv-eval/
.venv-seed/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Node
node_modules/

# Local Claude Code settings (personal, not shared)
.claude/settings.local.json

# OS / editor
.DS_Store
*.swp
.idea/

# Audit log — run artifact, regenerated by every demo run
audit/
